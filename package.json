{
  "name": "@anndata-omics-bridge/apb-catalog",
  "version": "0.1.0",
  "description": "apb-catalog's API in TypeScript: look up APB result fields by meaning in the browser",
  "license": "MIT",
  "author": "Witold E. Wolski <witold.wolski@fgcz.uzh.ch>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anndata-omics-bridge/apb-catalog-ts.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "hyparquet": "1.31.4",
    "hyparquet-compressors": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
